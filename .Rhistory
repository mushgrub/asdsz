non_divergent_thinking =~ new_AQ_social_cognition_FU2 + new_AQ_social_discourse_FU2 + new_AQ_imagination_FU2+ spq_eccentric_behavior_FU2 +  MSS_scores_FU2
"
cfa_3f = cfa(cfa_3F_FU2, data_FU2)
